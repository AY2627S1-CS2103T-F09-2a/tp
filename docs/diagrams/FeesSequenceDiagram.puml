@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant ":FeesCommandParser" as FeesParser LOGIC_COLOR
participant "c:FeesCommand" as Fees LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> Logic : execute("fees min/100")
activate Logic
Logic -> Parser : parseCommand("fees min/100")
activate Parser

create FeesParser
Parser -> FeesParser : FeesCommandParser()
activate FeesParser
FeesParser --> Parser
deactivate FeesParser

Parser -> FeesParser : parse(" min/100")
activate FeesParser
note right of FeesParser
Validate exactly one min/ argument,
decimal syntax and range.
minimumAmount = BigDecimal("100")
end note

create Fees
FeesParser -> Fees : FeesCommand(minimumAmount)
activate Fees
Fees --> FeesParser
deactivate Fees

FeesParser --> Parser : c
deactivate FeesParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
FeesParser -[hidden]-> Parser
destroy FeesParser

Parser --> Logic : c
deactivate Parser

Logic -> Fees : execute(m)
activate Fees
Fees -> Model : updateFilteredPersonList(predicate)
activate Model
note right of Model
Replace the active filter over all students.
Match only a present fee >= minimumAmount.
Keep stored order and the live predicate.
end note
Model --> Fees
deactivate Model
Fees -> Model : getFilteredPersonList()
activate Model
Model --> Fees : filtered students
deactivate Model
note right of Fees
Count matches with size().
Create CommandResult r with
"N student(s) with outstanding fees."
end note
Fees --> Logic : r
deactivate Fees

[<-- Logic : r
deactivate Logic
@enduml
