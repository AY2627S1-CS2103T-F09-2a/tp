@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant ":FindGuardianCommandParser" as FindGuardianParser LOGIC_COLOR
participant "c:FindGuardianCommand" as FindGuardian LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:GuardianContainsKeywordsPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> Logic : execute("findguardian mei 9234-5678")
activate Logic
Logic -> Parser : parseCommand("findguardian mei 9234-5678")
activate Parser
create FindGuardianParser
Parser -> FindGuardianParser
Parser -> FindGuardianParser : parse(" mei 9234-5678")
activate FindGuardianParser
note right of FindGuardianParser
Trim, normalize to NFC and split on whitespace.
Reject the input if it is empty or any keyword
breaks the guardian-name character rules.
end note
create Predicate
FindGuardianParser -> Predicate : GuardianContainsKeywordsPredicate(keywords)
create FindGuardian
FindGuardianParser -> FindGuardian : FindGuardianCommand(p)
FindGuardianParser --> Parser : c
deactivate FindGuardianParser
Parser --> Logic : c
deactivate Parser

Logic -> FindGuardian : execute(m)
activate FindGuardian
FindGuardian -> Model : updateFilteredPersonList(p)
activate Model

loop each stored student
    Model -> Predicate : test(student)
    activate Predicate
    Predicate --> Model
    deactivate Predicate
end
note over Predicate, Model
A student matches if any keyword is a whole
guardian-name word (ignoring case), or a valid
phone equal to the guardian phone once
separators are removed.
end note

Model --> FindGuardian
deactivate Model
FindGuardian -> Model : getFilteredPersonList()
activate Model
Model --> FindGuardian : matching students
deactivate Model
note right of FindGuardian
r:CommandResult reports
"N student(s) listed!"
end note
FindGuardian --> Logic : r
deactivate FindGuardian

Logic -> FindGuardian : shouldSaveAddressBook()
activate FindGuardian
FindGuardian --> Logic : false
deactivate FindGuardian

[<-- Logic : r
deactivate Logic
@enduml
