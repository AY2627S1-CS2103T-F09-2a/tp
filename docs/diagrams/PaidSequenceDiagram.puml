@startuml
!include style.puml

skinparam ArrowFontStyle plain

actor Tutor
box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Parser LOGIC_COLOR
participant ":PaidCommand" as Paid LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

Tutor -> Logic : execute("paid 1")
activate Logic
Logic -> Parser : parseCommand("paid 1")
Parser --> Logic : command
Logic -> Paid : execute(model)
activate Paid
Paid -> Model : getFilteredPersonList()
Model --> Paid : displayed students
note over Paid
Validate index and require a fee.
Failure returns before any mutation.
end note
Paid -> Model : setPerson(original, updatedWithoutFee)
note over Model
Keep active filter; a paid student
no longer matches the fees filter.
end note
Paid --> Logic : payment feedback
 deactivate Paid
Logic -> Storage : saveAddressBook(model.getAddressBook())
Storage --> Logic : saved
note over Logic, Storage
A save failure is reported;
in-memory changes may remain.
end note
Logic --> Tutor : payment feedback
 deactivate Logic
@enduml
